# VulnSlayer Environment Configuration
# Copy this file to .env and fill in your values

# ─── GitHub ───────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (repo scope required)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Target repo where CVE issues are raised and PRs will be created
GITHUB_OWNER=your-org-or-username
GITHUB_REPO=your-repo-name

# ─── Issue Tracker ────────────────────────────────────────────────────────────
# Options: github | jira
TRACKER=github

# ─── Jira via mcp-atlassian (only required if TRACKER=jira) ──────────────────
# mcp-atlassian: https://github.com/sooperset/mcp-atlassian
JIRA_HOST=https://your-org.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_TOKEN=your_jira_api_token
JIRA_PROJECT=SEC

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b
